{
  "name": "move",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/shared-types",
    "packages/frontend",
    "packages/backend"
  ],
  "scripts": {
    "dev:frontend": "bun run --cwd packages/frontend start",
    "build:shared-types": "bun run --cwd packages/shared-types build",
    "build:frontend": "bun run --cwd packages/frontend export:web",
    "lint": "biome check . && bun run --cwd packages/frontend lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate:agents-md": "bun ./scripts/check-agents-md-size.mjs && bun ./scripts/test-check-agents-md-size.mjs",
    "postinstall": "bun run build:shared-types",
    "dev:backend": "bun run --cwd packages/backend dev",
    "build:backend": "bun run --cwd packages/backend build",
    "db:generate": "bun run --cwd packages/backend db:generate",
    "db:migrate": "bun run --cwd packages/backend db:migrate",
    "build": "bun run build:shared-types && bun run build:backend",
    "typecheck": "bun run build:shared-types && bun run --cwd packages/backend typecheck && bun run --cwd packages/frontend typecheck",
    "validate:gates": "bun ./scripts/check-migration-phase-markers.mjs && bun ./scripts/check-workflow-secrets.mjs && bun ./scripts/test-gates.mjs",
    "check": "bun run validate:agents-md && bun run validate:gates && bun run typecheck && bun run build",
    "test": "bun run build:shared-types && bun run --cwd packages/frontend test && bun run --cwd packages/backend test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "overrides": {
    "@oxy.so/contracts": "5.6.0",
    "@oxy.so/core": "^6.11.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/bloom": "15.0.0",
    "@oxy.so/services": "12.9.0",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1"
  },
  "resolutions": {
    "@oxy.so/contracts": "5.6.0",
    "@oxy.so/core": "^6.11.0",
    "@oxy.so/protocol": "1.4.1",
    "@oxy.so/bloom": "15.0.0",
    "react-native-css": "3.1.0-rc.0",
    "lightningcss": "1.30.1"
  }
}
