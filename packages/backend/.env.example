# Backend runtime configuration for Oxy Move. Every variable is parsed in
# src/config.ts — the only module that reads process.env.
PORT=3000
NODE_ENV=development
# LOG_LEVEL=debug

# PostgreSQL. Required — the server refuses to start without it.
# `docker compose -f ../../docker-compose.postgres.yml up -d postgres`
DATABASE_URL=postgres://oxymove:oxymove@127.0.0.1:5437/oxymove_dev

# Redis (BullMQ queue `migration`, the stalled-job sweep, the media-upload
# window). Optional locally: without it jobs run in-process. Production reads
# the shared /oxy/_shared/REDIS_URL.
# REDIS_URL=redis://127.0.0.1:6379

# Oxy and Mention.
OXY_API_URL=https://api.oxy.so
MENTION_API_URL=https://api.mention.earth

# Local development only: production attests the ECS task role (oxy-move-task)
# and holds NO key pair. Move's Oxy application must hold the privileged scopes
# linked-accounts:read, federation:identities:resolve, files:user-media:write and
# notifications:write (see README "Oxy grants"). It never needs federation:write.
# OXY_SERVICE_API_KEY=
# OXY_SERVICE_API_SECRET=

# Oxy-wide budget for /assets/service/user-media, per APPLICATION (~30/min).
# MEDIA_UPLOADS_PER_MINUTE=30
# MEDIA_MAX_BYTES=104857600
# MIGRATION_WORKER_CONCURRENCY=2

# Tests only: a server the pipeline tests may create databases on.
# TEST_DATABASE_URL=postgres://oxy:oxy@127.0.0.1:5432/oxy_dev
