{
  "name": "@move/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "bun --watch server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "NODE_ENV=test bun test"
  },
  "dependencies": {
    "@move/shared-types": "workspace:*",
    "@oxy.so/contracts": "^2.2.0",
    "@oxy.so/core": "^1.18.0",
    "@oxy.so/db": "^1.0.0",
    "@oxy.so/federation": "^2.1.1",
    "bullmq": "^6.3.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "0.45.2",
    "express": "^4.22.2",
    "he": "^1.2.0",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "sanitize-html": "^2.17.7",
    "socket.io": "^4.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^4.17.23",
    "@types/he": "^1.2.3",
    "@types/node": "^20.0.0",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3"
  }
}
