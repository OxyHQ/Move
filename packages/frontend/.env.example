# Oxy client id — the ApplicationCredential publicKey (oxy_dk_…) for Oxy Move.
# Register an Application + public credential at https://console.oxy.so.
EXPO_PUBLIC_OXY_CLIENT_ID=

# Backend API base URL.
EXPO_PUBLIC_API_URL=https://api.move.oxy.so

# Oxy's API (sessions, accounts) — what OxyProvider talks to. Not the Move API.
EXPO_PUBLIC_OXY_API_URL=https://api.oxy.so
